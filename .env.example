# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth (enabled by default on Supabase projects)
# SUPABASE_ANON_KEY is used for signup/login via Supabase Auth.
# SUPABASE_SERVICE_ROLE_KEY is used for admin operations (set app_metadata.tenant_id).
# RLS policies use auth.jwt()->'app_metadata'->>'tenant_id' for tenant isolation.
#
# REQUIRED: Email confirmation must be enabled AND the "Confirm signup" email
# template must include the {{ .Token }} placeholder so a 6-digit OTP is sent
# (not just a magic link). See Authentication > Providers > Email.
# Verification uses verifyOtp({ type: 'email' }), which works for both signup
# and magiclink tokens.

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Session
SESSION_SECRET=change-me-to-a-random-string
COOKIE_DOMAIN=.playsole.xyz

# Internal service-to-service auth (must be identical across all processes)
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-secret

# Cookies: set COOKIE_SECURE=true when serving over HTTPS
# COOKIE_SECURE=true

# OIDC issuer advertised in the discovery document and used as the `iss` claim of ID tokens.
# Must be the public origin your clients reach (dev: http://localhost:8080, prod: https://your-domain).
# OIDC_ISSUER=http://localhost:8080

# JWT signing keypair (RS256, PEM with \n escapes). REQUIRED in production; in dev a keypair
# is generated into .data/ automatically. Generate with:
#   openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Gateway
# PORT=8080
# AUTH_PORT=3001
# PROFILE_PORT=3002
# CONSENT_PORT=3003
# SESSION_PORT=3004
# SECURITY_PORT=3005
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_TOKEN_WINDOW_MS=60000
RATE_LIMIT_TOKEN_MAX=30
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100

# Resend (transactional emails)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@playsole.xyz

# Twilio (phone verification SMS). Unset in dev — codes are echoed inline.
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+15551234567

# Public base URL used in verification/magic-link emails
# PUBLIC_BASE_URL=https://playsole.xyz

# When true, verification and magic-link tokens are echoed back in API responses (dev). Defaults to true.
# INLINE_TOKEN_RESPONSE=true

# Cloudinary (avatar upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Service URLs (defaults to localhost)
SERVICE_AUTH_URL=http://localhost:3001
SERVICE_PROFILE_URL=http://localhost:3002
SERVICE_CONSENT_URL=http://localhost:3003
SERVICE_SESSION_URL=http://localhost:3004
SERVICE_SECURITY_URL=http://localhost:3005

# Public Gateway Origin & OIDC Issuer (e.g. https://one.playsole.xyz in production)
# BASE_URL=https://one.playsole.xyz
# PUBLIC_ORIGIN=https://one.playsole.xyz
# OIDC_ISSUER=https://one.playsole.xyz

# WebAuthn / MFA (security service)
# Public origin browsers will use for WebAuthn ceremonies (dev: http://localhost:8080).
MFA_RP_ID=localhost
MFA_RP_NAME=Playsole One
MFA_RP_ORIGIN=http://localhost:8080
# Number of single-use backup codes issued when they are generated.
# BACKUP_CODE_COUNT=10

# Suspicious-activity detection (security service)
# RISK_NEW_LOCATION_WINDOW_MS=7200000
# RISK_IMPOSSIBLE_TRAVEL_MS=900000

# Account recovery (security service): how long a recovery token stays valid.
# RECOVERY_TOKEN_TTL_MS=1800000

# Login attempt tracking / account lockout (auth service)
# MAX_FAILED_LOGIN_ATTEMPTS=5
# LOCKOUT_MS=900000
# LOCKOUT_WINDOW_MS=900000